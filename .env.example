# Discord Bot Configuration
# Copy file này thành .env và điền thông tin của bạn

# Discord Bot Token (BẮT BUỘC)
# Lấy từ: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Multi-PC support (OPTIONAL, per-PC)
# Bind this bot process to one or more Discord channels. Only messages and
# slash commands from these channels will be handled on this PC.
# Use when the same DISCORD_BOT_TOKEN is shared across several PCs, each
# managing its own local ROK bot and listening on its own channel.
# Value: channel ID, or comma-separated list of channel IDs.
# Leave empty to listen everywhere (single-PC setup).
# Example: INSTANCE_CHANNEL=123456789012345678
INSTANCE_CHANNEL=

# Bot Settings
DEBUG=True
LOG_LEVEL=INFO
PREFIX=!

# Bot Activity
ACTIVITY_TYPE=playing
ACTIVITY_NAME=Discord Bot

# Embed Settings
EMBED_COLOR=3498db

# Command Settings
COMMAND_COOLDOWN=3
MAX_MESSAGE_LENGTH=2000

# Permissions
GUILD_ONLY=False
DEFAULT_PERMISSIONS=0

# Auto-Update
# prompt = check GitHub on startup, ask user [y/N] (default N)
# off    = skip update check entirely
AUTO_UPDATE=prompt

# ---------------------------------------------------------------------------
# Freeze Watchdog (monitors each running instance's ACTIVITY LOG and alerts
# when one stops advancing for ~15 min or gets stuck in a bad state).
# Requires the bot to run as Administrator (it auto-requests elevation).
# ---------------------------------------------------------------------------
# Master on/off. 1/true = on (default), 0/false = off (toggle live with /watchdog).
WATCHDOG_ENABLED=1
# Minutes between sweeps (default 3). Each sweep briefly takes over the mouse to
# read every running instance, so raise this (e.g. 5) if you want it less busy.
WATCHDOG_INTERVAL_MIN=3
# Channel to post freeze alerts in. If empty, falls back to the first
# INSTANCE_CHANNEL id. Example: ALERT_CHANNEL=123456789012345678
ALERT_CHANNEL=
# Optional: who to @mention on a freeze alert. Paste a raw mention:
#   a user  -> <@169923128833605632>
#   a role  -> <@&123456789012345678>
# Leave empty for no mention.
ALERT_MENTION=

# ---------------------------------------------------------------------------
# Idle gate: cursor-moving operations (start/stop clicks, watchdog reads) wait
# while someone is physically using this computer, so the bot never fights the
# local user for the mouse.
# ---------------------------------------------------------------------------
# The machine counts as "in use" if there was local mouse/keyboard input within
# this many seconds. Held operations re-check every UI_IDLE_RECHECK_SECONDS.
# Set 0 to disable the gate. Default 10.
UI_PAUSE_IDLE_SECONDS=10
# How often (seconds) a held operation re-checks for idleness. Default 10.
UI_IDLE_RECHECK_SECONDS=10
# Safety valve: after this many seconds of CONTINUOUS local use, a held
# operation runs anyway so automation can't starve. Default 900 (15 min).
UI_IDLE_MAX_WAIT_SECONDS=900